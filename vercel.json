{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/admin/", "destination": "/admin/index.html" },
    { "source": "/admin/login", "destination": "/admin/login.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/products", "destination": "/products.html" },
    { "source": "/about-us", "destination": "/about-us.html" },
    { "source": "/contact-us", "destination": "/contact-us.html" },
    { "source": "/purification-process", "destination": "/purification-process.html" },
    { "source": "/lab-report", "destination": "/lab-report.html" },
    { "source": "/api/admin/analytics", "destination": "/api/analytics.js" },
    { "source": "/api/admin/login", "destination": "/api/login.js" },
    { "source": "/api/admin/check", "destination": "/api/check.js" },
    { "source": "/api/admin/orders/:match*", "destination": "/api/orders.js" },
    { "source": "/api/admin/orders", "destination": "/api/orders.js" },
    { "source": "/api/admin/loans/:match*", "destination": "/api/loans.js" },
    { "source": "/api/admin/loans", "destination": "/api/loans.js" },
    { "source": "/api/admin/expenses/:match*", "destination": "/api/expenses.js" },
    { "source": "/api/admin/expenses", "destination": "/api/expenses.js" },
    { "source": "/api/admin/products/:match*", "destination": "/api/products.js" },
    { "source": "/api/admin/products", "destination": "/api/products.js" },
    { "source": "/api/admin/contacts/:match*", "destination": "/api/contacts.js" },
    { "source": "/api/admin/contacts", "destination": "/api/contacts.js" },
    { "source": "/api/admin/lab-data/:match*", "destination": "/api/lab-data.js" },
    { "source": "/api/admin/lab-data", "destination": "/api/lab-data.js" },
    { "source": "/api/order", "destination": "/api/order.js" },
    { "source": "/api/contact", "destination": "/api/contact.js" }
  ]
}
